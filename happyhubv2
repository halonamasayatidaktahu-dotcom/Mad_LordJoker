		{ id = "rbxassetid://132022412865109", pitch = 0.25 },
		{ id = "rbxassetid://120370199589746", pitch = 0.25 },
		{ id = "rbxassetid://102275179347855", pitch = 0.25 },
		{ id = "rbxassetid://121549600398336", pitch = 0.24 }
	}

	local createdSounds = {}

	for _, data in ipairs(sounds) do
		local sound = Instance.new("Sound")
		sound.SoundId = data.id
		sound.Pitch = data.pitch
		sound.Volume = 10
		sound.Parent = workspace

		local effect = Instance.new("PitchShiftSoundEffect", sound)
		effect.Octave = (_ == 8) and 1.8 or 1.75
		effect.Priority = 1000

		table.insert(createdSounds, sound)
	end

	local function startSequence(index)
		if index > #createdSounds then
			playSequence()
			return
		end

		local sound = createdSounds[index]
		sound:Play()
		sound.Ended:Connect(function()
			startSequence(index + 1)
		end)
	end

	startSequence(1)
end

