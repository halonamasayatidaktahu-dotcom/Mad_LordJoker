	end
	
	for _,Prt in pairs(player.Character:GetChildren()) do
		Prt:Destroy()
	end
	
	for _,Prt in pairs(FalseCharacter:GetChildren()) do
		Prt.Parent = player.Character
	end
	
	for _,Prt in pairs(Accessories) do
		Prt.Parent = player.Character
	end
	
	self:Destroy()
end

