--Kill--
function KillThem()
del = true
atkd = true
chara.Humanoid.WalkSpeed = 0
bladeactive = true
SwingSnd:Play()
Sheath(2)
wait(.01)
for i = 0,.75,.22 do
wait(.01)
TC.C0 = clerp(ITCF,TCF * CFrame.fromEulerAnglesXYZ(0,0,math.rad(90)),.4+i)
