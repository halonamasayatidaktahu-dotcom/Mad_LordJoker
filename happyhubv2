				pcall(function()
					if same.ClassName == 'Script' then
						same.Disabled = true
					end	
				end)
				for i,v in pairs(same:GetChildren()) do
					scriptsourceoff(v)
				end
			end
			scriptsourceoff(fold)
			while not _G.yes do wait() end -- Stop missing terrain

			countNum = 0
			function addNumTo(same)
				if same.Parent ~= nil then
					countNum = countNum + 1
				end
				for i,v in pairs(same:GetChildren()) do
					addNumTo(v)
				end
			end
			addNumTo(fold)
